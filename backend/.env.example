PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/fleet_management
# JWT_SECRET must be 32+ characters of random entropy — generate with:
#   openssl rand -hex 32
# (the server refuses to start with a placeholder/weak value)
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=12h
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@12345
